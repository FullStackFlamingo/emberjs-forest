{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "es2024",
    "module": "nodenext",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "nodenext",
    "sourceMap": true
  },
  "include": ["**/*"],
  "exclude": ["./dist"]
}
